# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/aigentra"

# Payment Execution Mode ("dev_stub" | "paypal")
# Note: Production environment strictly requires PAYMENT_MODE="paypal"
PAYMENT_MODE="dev_stub"

# PayPal Sandbox Credentials (Optional in dev_stub mode)
PAYPAL_CLIENT_ID="mock_client_id"
PAYPAL_CLIENT_SECRET="mock_client_secret"
PAYPAL_WEBHOOK_ID="mock_webhook_id"
PAYPAL_ENV="sandbox"

# Application Base URL
APP_BASE_URL="http://localhost:3000"

# AI Provider Configuration (Optional - falls back to AI Replay Mode)
AI_PROVIDER="gemini"
GEMINI_API_KEY="mock_gemini_api_key"

# Product Data (Channel3) (Optional - falls back to seeded catalog)
CHANNEL3_API_KEY="mock_channel3_api_key"

# Authority Mandate Ed25519 Keys
MANDATE_SIGNING_PRIVATE_KEY="mock_ed25519_private_key"
MANDATE_SIGNING_PUBLIC_KEY="mock_ed25519_public_key"

# Session Security
SESSION_SECRET="mock_session_secret_at_least_32_chars_long"

# AG Studio License (Optional - falls back to watermark evaluation)
NEXT_PUBLIC_AG_LICENSE_KEY="mock_ag_studio_trial_license_key"
