{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/rooms/execute",
              "@/rooms/execute",
              "**/rooms/execute/**",
              "@/rooms/execute/**",
              "@paypal/paypal-server-sdk",
              "@paypal/*"
            ],
            "message": "AGENTS.md Violation: Only src/rooms/execute may import payment gateways, PayPal SDKs, or execute room internals."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/rooms/execute/**", "src/app/api/checkout/**", "src/app/api/dev-stub/**", "tests/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/rooms/propose/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/rooms/execute/**",
                  "@/rooms/execute/**",
                  "**/rooms/execute",
                  "@/rooms/execute",
                  "@paypal/paypal-server-sdk",
                  "@paypal/*"
                ],
                "message": "AGENTS.md Golden Rule 1: Propose room is forbidden from importing from the Execute room or PayPal SDK."
              }
            ]
          }
        ]
      }
    }
  ]
}
